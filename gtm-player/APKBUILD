# Maintainer: Vaishnav Sabari Girish <vaishnav.sabari.girish@gmail.com>
pkgname=gtm-player
pkgver=0.2.98
pkgrel=0
pkgdesc="Reimagined terminal audio player with background daemon, YouTube/Spotify, radio and podcasts"
url="https://gtmd.dev"
arch="x86_64 aarch64"
license="GPL-3.0-only"
makedepends="
	alsa-lib-dev
	bash
	cargo
	cargo-auditable
	clang-dev
	cmake
	dbus-dev
	pandoc-cli
	pkgconf
	samurai
	"
subpackages="
	$pkgname-doc
	$pkgname-bash-completion
	$pkgname-zsh-completion
	$pkgname-fish-completion
	"
source="gtm-$pkgver.tar.gz::https://github.com/craftty-org/gtm/archive/refs/tags/v$pkgver.tar.gz"
builddir="$srcdir/gtm-$pkgver"
options="net !check"

prepare() {
	default_prepare
	cargo fetch --target="$CTARGET" --locked

	# rquickjs-sys ships no bindings for the Alpine target triple.
	# The unknown-linux-musl bindings are ABI-compatible, so symlink them.
	local reg
	reg=$(find "${CARGO_HOME:-$HOME/.cargo}"/registry/src -type d -name 'rquickjs-sys-*' | head -n1)
	if [ -n "$reg" ] && [ -d "$reg/src/bindings" ]; then
		ln -sf x86_64-unknown-linux-musl.rs \
			"$reg/src/bindings/x86_64-alpine-linux-musl.rs"
		ln -sf aarch64-unknown-linux-musl.rs \
			"$reg/src/bindings/aarch64-alpine-linux-musl.rs" 2>/dev/null || true
	fi
}

build() {
	cargo auditable build --frozen --release --features youtube

	# Man pages (pandoc) and shell completions generated by the built binaries
	./scripts/build/manpages.sh artifacts
	./scripts/build/completions.sh "$PWD/artifacts"
}

check() {
	cargo test --frozen
}

package() {
	# Binaries
	install -Dm755 target/release/gtm -t "$pkgdir"/usr/bin/
	install -Dm755 target/release/gtmd -t "$pkgdir"/usr/bin/

	# Man pages
	install -Dm644 artifacts/man/gtm.1 artifacts/man/gtmd.1 artifacts/man/gtmd-ipc.1 \
		-t "$pkgdir"/usr/share/man/man1/

	# Shell completions
	install -Dm644 artifacts/completions/gtm.bash \
		"$pkgdir"/usr/share/bash-completion/completions/gtm
	install -Dm644 artifacts/completions/gtmd.bash \
		"$pkgdir"/usr/share/bash-completion/completions/gtmd
	install -Dm644 artifacts/completions/_gtm \
		"$pkgdir"/usr/share/zsh/site-functions/_gtm
	install -Dm644 artifacts/completions/_gtmd \
		"$pkgdir"/usr/share/zsh/site-functions/_gtmd
	install -Dm644 artifacts/completions/gtm.fish \
		"$pkgdir"/usr/share/fish/vendor_completions.d/gtm.fish
	install -Dm644 artifacts/completions/gtmd.fish \
		"$pkgdir"/usr/share/fish/vendor_completions.d/gtmd.fish

	# License and docs
	install -Dm644 LICENSE -t "$pkgdir"/usr/share/licenses/$pkgname/
	install -Dm644 README.md -t "$pkgdir"/usr/share/doc/$pkgname/
}

sha512sums="
1a2965c5d90aa642fb8cea16de6e9a9fdd67111fb52fd6f644a04f6badbee55082b1b51530826c075403b74464cf213b31072deb7790c0f55bff95ac7fbcbe7b  gtm-0.2.97.tar.gz
"
